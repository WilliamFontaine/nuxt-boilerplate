{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":preserveSemverRanges"
  ],
  "schedule": ["before 6am on Monday"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "Disable resolutions",
      "matchDepTypes": ["resolutions"],
      "enabled": false
    },
    {
      "description": "Group Nuxt ecosystem updates",
      "groupName": "Nuxt ecosystem",
      "matchPackageNames": ["/^@nuxt//", "/^nuxt/", "/^@nuxtjs//"]
    },
    {
      "description": "Group Pinia packages",
      "groupName": "Pinia",
      "matchPackageNames": ["/^@pinia//", "/^pinia/"]
    },
    {
      "description": "Group Prisma packages",
      "groupName": "Prisma",
      "matchPackageNames": ["/^@prisma//", "/^prisma$/"]
    },
    {
      "description": "Group icon packages",
      "groupName": "Iconify icons",
      "automerge": true,
      "matchPackageNames": ["/^@iconify-json//"]
    },
    {
      "description": "Group testing tools",
      "matchPackageNames": [
        "@nuxt/test-utils",
        "@vue/test-utils",
        "happy-dom",
        "/^@playwright//",
        "/^playwright/",
        "/^vitest$/",
        "/^@vitest//"
      ],
      "groupName": "Testing tools"
    },
    {
      "description": "Group linting and formatting tools",
      "matchPackageNames": [
        "husky",
        "/^eslint/",
        "/^prettier/",
        "/^@commitlint//"
      ],
      "groupName": "Linting and formatting",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group TypeScript packages",
      "matchPackageNames": ["tsx", "/^typescript$/", "/^@types//"],
      "groupName": "TypeScript"
    },
    {
      "description": "Auto-merge patch and minor updates for stable dependencies",
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Hold back major updates for manual review",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Auto-merge dev dependency patches",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
