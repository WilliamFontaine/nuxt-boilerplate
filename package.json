{
  "name": "nuxt-boilerplate",
  "version": "1.2.2",
  "description": "A Nuxt 4 boilerplate with TypeScript, Pinia, Prisma, i18n, ESLint, Prettier, Vitest, Playwright and more.",
  "author": "William Fontaine",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/WilliamFontaine/nuxt-boilerplate",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamFontaine/nuxt-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/WilliamFontaine/nuxt-boilerplate/issues"
  },
  "scripts": {
    "clean": "rm -rf .nuxt .output node_modules dist coverage playwright-report test-results .nitro",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "prepare": "husky",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier --write --list-different .",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "processor:dev": "nuxt-processor dev",
    "changelog": "pnpm exec git-cliff --output CHANGELOG.md",
    "release:patch": "pnpm version patch && git push --follow-tags",
    "release:minor": "pnpm version minor && git push --follow-tags",
    "release:major": "pnpm version major && git push --follow-tags"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "4.6.1",
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/seo": "^3.3.0",
    "@pinia/nuxt": "^0.11.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.12",
    "nuxt": "4.4.2",
    "nuxt-auth-utils": "^0.5.26",
    "nuxt-security": "^2.5.0",
    "pg": "^8.16.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/openmoji": "^1.2.19",
    "@iconify-json/simple-icons": "^1.2.65",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/test-utils": "3.23.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@vitest/coverage-v8": "4.1.5",
    "@vue/test-utils": "2.4.10",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "happy-dom": "20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "playwright-core": "^1.57.0",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "swagger-jsdoc": "^6.2.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "*.{js,ts,vue,css,scss,md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
